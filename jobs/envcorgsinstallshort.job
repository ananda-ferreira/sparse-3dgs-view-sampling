#!/bin/bash

#SBATCH --job-name=envcorgsinstall           # Job name
#SBATCH --output=envcorgsinstall.%j.out      # Name of output file (%j expands to jobId)
#SBATCH --cpus-per-task=4              # Schedule one core
#SBATCH --time=02:00:00                # Run time (hh:mm:ss) - run for one hour max
#SBATCH --partition=acltr
#SBATCH --gres=gpu:1

set -e
set -x

module load Anaconda3/2025.06-1        # step 1: specify anaconda version

export TMPDIR=/home/anaf/tmp

# # STEP 1:  
# Load the conda shell function (required in batch jobs)
source /opt/itu/easybuild/software/Anaconda3/2025.06-1/etc/profile.d/conda.sh
conda activate /home/anaf/anaconda3-2025/envs/cor-gs

# IT 1
pip install --no-cache-dir torch==2.1.2+cu121 \
    torchvision==0.16.2+cu121 \
    torchaudio==2.1.2 \
    --index-url https://download.pytorch.org/whl/cu121

# IT 3: Fix NumPy ABI to match PyTorch 2.1.x expectations (downgrade NumPy 2.x -> 1.26.x)
pip install --no-cache-dir --upgrade "numpy==1.26.4" "pybind11>=2.12"

# # intermediate step
python - << 'EOF'
import torch, numpy as np
print("Torch:", torch.__version__)
print("CUDA:", torch.version.cuda, torch.cuda.is_available())
print("NumPy:", np.__version__)
EOF

echo "DONE."