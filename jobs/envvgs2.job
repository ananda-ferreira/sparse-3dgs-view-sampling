#!/bin/bash

#SBATCH --job-name=envvgs2           # Job name
#SBATCH --output=envvgs2.%j.out      # Name of output file (%j expands to jobId)
#SBATCH --cpus-per-task=4              # Schedule one core
#SBATCH --time=03:00:00                # Run time (hh:mm:ss) - run for one hour max
#SBATCH --partition=acltr           # Run on either the Red or Brown queue
#SBATCH --gres=gpu:1                    # needed for submodule build

set -e

module load Anaconda3/2025.06-1                         # specify anaconda version
module load CUDA/12.1.1             # needed for nvcc during submodules build

export CONDA_PKGS_DIRS=/home/anaf/anaconda3-2025/cache

